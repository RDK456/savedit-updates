// ---- Flash Shared Object (.sol): AMF0 or AMF3 values
function parseSol(b) {
  const P = Patcher(b), r = new Rd(b);
  if (r.u16(false) !== 0x00bf) throw Error('not a .sol file');
  r.u32(false);
  if (latin1(r.bytes(4)) !== 'TCSO') throw Error('not a .sol file');
  r.bytes(6);
  const name = latin1(r.bytes(r.u16(false))), amf = r.u32(false);
  const u8s = s => te8.encode(s);
  // AMF0
  const s0 = () => td8.decode(r.bytes(r.u16(false)));
  const enc0 = s => { const u = u8s(s); return u.length < 65536 ? concat([Uint8Array.of(2), W().num('Uint16', u.length, false).out, u]) : concat([Uint8Array.of(12), W().num('Uint32', u.length, false).out, u]); };
  function v0() {
    const s = r.o, m = r.u8();
    switch (m) {
      case 0: { const v = r.f64(false); return P.leaf(Number.isInteger(v) ? 'int' : 'float', v, s, 9, x => W().u8(0).num('Float64', x, false).out, { min: -(2 ** 53), max: 2 ** 53 }); }
      case 1: return P.leaf('bool', !!r.u8(), s, 2, x => Uint8Array.of(1, x ? 1 : 0));
      case 2: { const v = s0(); return P.leaf('str', v, s, r.o - s, enc0); }
      case 12: { const v = td8.decode(r.bytes(r.u32(false))); return P.leaf('str', v, s, r.o - s, enc0); }
      case 3: return props0({});
      case 16: { const o = { [LABEL]: s0() }; return props0(o); }
      case 8: r.u32(false); return props0({});
      case 10: return Array.from({ length: r.u32(false) }, v0);
      case 11: { const v = r.f64(false); r.i16(false); return ro(new Date(v).toISOString()); }
      case 5: return ro('null'); case 6: return ro('undefined');
      case 7: return ro(`ref ${r.u16(false)}`);
      case 15: return ro(td8.decode(r.bytes(r.u32(false))));
      case 17: return v3();
      default: throw Error(`AMF0 type ${m} at ${s}`);
    }
  }
  function props0(o) { for (;;) { const k = s0(); if (!k && b[r.o] === 9) { r.o++; return o; } let kk = k; while (kk in o) kk += "'"; o[kk] = v0(); } }
  // AMF3 (with string/object/trait reference tables)
  const strs = [], objs = [], traits = [];
  const u29 = () => { let v = 0; for (let i = 0; i < 4; i++) { const x = r.u8(); if (i === 3) return (v << 8) | x; v = (v << 7) | (x & 127); if (!(x & 128)) return v; } return v; };
  const encU29 = v => { v &= 0x1fffffff; if (v < 0x80) return [v]; if (v < 0x4000) return [v >> 7 | 128, v & 127]; if (v < 0x200000) return [v >> 14 | 128, v >> 7 & 127 | 128, v & 127]; return [v >> 22 | 128, v >> 15 & 127 | 128, v >> 8 & 127 | 128, v & 255]; };
  const s3 = () => { const h = u29(); if (!(h & 1)) return strs[h >> 1]; const n = h >> 1; if (!n) return ''; const v = td8.decode(r.bytes(n)); strs.push(v); return v; };
  const enc3str = s => { const u = u8s(s); return Uint8Array.from([6, ...encU29(u.length << 1 | 1), ...u]); };
  function v3() {
    const s = r.o, m = r.u8();
    switch (m) {
      case 0: return ro('undefined'); case 1: return ro('null');
      case 2: case 3: return P.leaf('bool', m === 3, s, 1, x => Uint8Array.of(x ? 3 : 2));
      case 4: { let v = u29(); if (v & 0x10000000) v -= 0x20000000; return P.leaf('int', v, s, r.o - s, x => Uint8Array.from([4, ...encU29(x)]), { min: -(2 ** 28), max: 2 ** 28 - 1 }); }
      case 5: { const v = r.f64(false); return P.leaf('float', v, s, 9, x => W().u8(5).num('Float64', x, false).out); }
      case 6: { const h = b[r.o]; const v = s3(); return h & 1 ? P.leaf('str', v, s, r.o - s, enc3str) : ro(v); }
      case 7: case 11: { const h = u29(); if (!(h & 1)) return ro(`ref ${h >> 1}`); const v = td8.decode(r.bytes(h >> 1)); objs.push(v); return ro(v); }
      case 8: { const h = u29(); if (!(h & 1)) return ro(`ref ${h >> 1}`); const v = r.f64(false); objs.push(v); return ro(new Date(v).toISOString()); }
      case 9: {
        const h = u29(); if (!(h & 1)) return objs[h >> 1] ?? ro(`ref ${h >> 1}`);
        const o = {}; objs.push(o);
        for (let k; (k = s3());) o[k] = v3();
        for (let i = 0; i < h >> 1; i++) o[i] = v3();
        return o;
      }
      case 10: {
        const h = u29(); if (!(h & 1)) return objs[h >> 1] ?? ro(`ref ${h >> 1}`);
        let tr;
        if (!(h & 2)) tr = traits[h >> 2];
        else { tr = { ext: !!(h & 4), dyn: !!(h & 8), cls: s3(), keys: [] }; const n = h >> 4; for (let i = 0; i < n; i++) tr.keys.push(s3()); traits.push(tr); }
        if (tr.ext) throw Error('externalizable AMF3 class ' + tr.cls);
        const o = tr.cls ? { [LABEL]: tr.cls } : {}; objs.push(o);
        for (const k of tr.keys) o[k] = v3();
        if (tr.dyn) for (let k; (k = s3());) o[k] = v3();
        return o;
      }
      case 12: { const h = u29(); if (!(h & 1)) return ro(`ref ${h >> 1}`); r.bytes(h >> 1); objs.push(0); return ro(`<${h >> 1} bytes>`); }
      default: throw Error(`AMF3 type ${m} at ${s}`);
    }
  }
  const root = { [LABEL]: name };
  while (!r.eof) {
    const k = amf === 3 ? s3() : s0();
    root[k] = amf === 3 ? v3() : v0();
    r.u8();
  }
  return { P, root };
}
FORMATS.push({
  id: 'sol', label: 'Flash Shared Object (.sol)', exts: ['sol'],
  test: b => b[0] === 0 && b[1] === 0xbf && latin1(b.subarray(6, 10)) === 'TCSO',
  open(b) {
    const { P, root } = parseSol(b);
    return { root, save() { const out = P.save(); new DataView(out.buffer).setUint32(2, out.length - 6); return out; } };
  },
});

// keep the binary-scan fallback last in the "Read as" list
