  id: 'nbt', label: 'Minecraft NBT (level.dat, .nbt, .dat)', exts: ['dat', 'nbt', 'dat_old', 'schematic', 'litematic', 'mcstructure'],
  test: b => b[0] === 10 || b[0] === 0x1f && b[1] === 0x8b && (() => { try { return pako.inflate(b)[0] === 10; } catch { return false; } })() || b[8] === 10 && b.length > 12 && new DataView(b.buffer, b.byteOffset).getUint32(4, true) === b.length - 8,
